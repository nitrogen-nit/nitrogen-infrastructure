NITROGEN_PROMETHEUS_IMAGE=prom/prometheus:v3.14.0
NITROGEN_GRAFANA_IMAGE=grafana/grafana:13.0.7-slim
NITROGEN_LOKI_IMAGE=grafana/loki:3.7.6
NITROGEN_TEMPO_IMAGE=grafana/tempo:2.10.7
NITROGEN_OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.153.0
NITROGEN_ALLOY_IMAGE=grafana/alloy:v1.19.2

NITROGEN_PROMETHEUS_PORT=9090
NITROGEN_GRAFANA_PORT=3000
NITROGEN_LOKI_PORT=3100
NITROGEN_TEMPO_PORT=3200
NITROGEN_OTLP_GRPC_PORT=4317
NITROGEN_OTLP_HTTP_PORT=4318
NITROGEN_OTEL_HEALTH_PORT=13133
NITROGEN_ALLOY_PORT=12345

NITROGEN_PROMETHEUS_RETENTION=15d
NITROGEN_LOKI_RETENTION=168h
NITROGEN_TEMPO_RETENTION=72h

NITROGEN_GRAFANA_ADMIN_USER=admin
NITROGEN_GRAFANA_ADMIN_PASSWORD=nitrogen-local
NITROGEN_BACKEND_URL=http://localhost:8080
NITROGEN_TRACE_SMOKE_ENABLED=false
